3b9\u03c4\u03b9\u03bf\u03cd \u03c3\u03b1\u03c2 \u03b5\u03af\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u03b5\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c3\u03b1\u03c2 \u03c7\u03ce\u03c1\u03bf, \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c0\u03bb\u03b7\u03b8\u03ce\u03c1\u03b1 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ce\u03bd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03b1\u03bb\u03cd\u03c8\u03b5\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b5\u03c2 \u03c3\u03b1\u03c2. \u03a4\u03b1 \u03bc\u03b9\u03ba\u03c1\u03cc\u03c4\u03b5\u03c1\u03b1 \u03c3\u03b5 \u03b2\u03ac\u03c1\u03bf\u03c2,&nbsp;2 \u03ba\u03b1\u03b9 4 \u03ba\u03b9\u03bb\u03ce\u03bd, \u03c0\u03c1\u03bf\u03c4\u03b5\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03b1\u03c0\u03bf\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b9\u03c3\u03bf\u03c1\u03c1\u03bf\u03c0\u03af\u03b1\u03c2 \u03ae \u03c4\u03b7\u03c2 \u03b5\u03c5\u03ba\u03b9\u03bd\u03b7\u03c3\u03af\u03b1\u03c2 \u03c4\u03c9\u03bd \u03ce\u03bc\u03c9\u03bd. \u03a4\u03b1 \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b1, 6 \u03ba\u03b9\u03bb\u03ac \u03ba\u03b1\u03b9 \u03ac\u03bd\u03c9, \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03c3\u03b1\u03c2 \u03b2\u03bf\u03b7\u03b8\u03ae\u03c3\u03bf\u03c5\u03bd \u03c3\u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03c4\u03b7\u03c2 \u03bb\u03b1\u03b2\u03ae\u03c2 \u03c3\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b5\u03bd\u03b4\u03c5\u03bd\u03ac\u03bc\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03ac\u03c4\u03c9 \u03bc\u03ad\u03c1\u03bf\u03c5\u03c2 \u03c4\u03bf\u03c5 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2. \u0393\u03b9\u03b1 \u03b1\u03b8\u03bb\u03b7\u03c4\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03b2\u03cc\u03bb\u03b5\u03ca, \u03c4\u03bf\u03c5 \u03c4\u03ad\u03bd\u03bd\u03b