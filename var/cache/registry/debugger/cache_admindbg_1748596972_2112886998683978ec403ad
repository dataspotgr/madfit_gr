d \u03ac\u03bb\u03b9\u03c0\u03b7 \u03bc\u03c5\u03ca\u03ba\u03ae \u03c3\u03bf\u03c5 \u03bc\u03ac\u03b6\u03b1. \u03a0\u03b1\u03c1\u03ad\u03c7\u03bf\u03bd\u03c4\u03b1\u03c2 4,8\u00a0g \u03c5\u03c8\u03b7\u03bb\u03ae\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03ba\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7 \u03b1\u03bd\u03ac \u03bc\u03b5\u03c1\u03af\u03b4\u03b1, \u03c4\u03bf \u03c1\u03cc\u03c6\u03b7\u03bc\u03b1 \u03b8\u03b1 \u03b1\u03bd\u03b5\u03b2\u03ac\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03b8\u03bb\u03b7\u03c4\u03b9\u03ba\u03ae \u03c3\u03bf\u03c5 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03b2\u03bf\u03b7\u03b8\u03ae\u03c3\u03b5\u03b9 \u03c3\u03c4\u03b7 \u03b4\u03b9\u03b1\u03c3\u03c6\u03ac\u03bb\u03b9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03b1\u03c7\u03cd\u03c4\u03b5\u03c1\u03b7\u03c2 \u03b1\u03c0\u03bf\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c4\u03c9\u03bd \u03bc\u03c5\u03ce\u03bd \u03c3\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03ac\u03c3\u03ba\u03b7\u03c3\u03b7\u03c2.<\/span><\/p>\n<p><span style=\"font-weight: 400\">\u0397 \u03bc\u03bf\u03bd\u03bf\u03cb\u03b4\u03c1\u03b9\u03ba\u03ae \u03ba\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7 \u03b5\u03bd\u03c5\u03b4\u03b1\u03c4\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b1 \u03bc\u03c5\u03ca\u03ba\u03ac \u03ba\u03cd\u03c4\u03c4\u03b1\u03c1\u03b1 \u03b5\u03bd\u03ce \u03b2\u03bf\u03b7\u03b8\u03ac\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 ATP (\u03a4\u03c1\u03b9\u03c6\u03c9\u03c3\u03c6\u03bf\u03c1\u03b9\u03ba\u03ae \u0391\u03b4\u03b5\u03bd\u03bf\u03c3\u03cd\u03bd\u03b7), \u03c4\u03bf\u03c5 \u00ab\u03b5\u03bd\u03b5\u03c1\u03b3\u03b5\u03b9\u03b1\u03ba\u03bf\u03cd \u03bd\u03bf\u03bc\u03af\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2\u00bb \u03c4\u03bf\u03c5 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03cd\u03c1\u03b9\u03b1\u03c2 \u03c0\u03b7\u03b3\u03ae\u03c2 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03b1\u03bd\u03b1\u03bb\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03cc, \u03b5\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03bf\u03bd\u03c4\u03b1\u03c2 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03c0\u03ac\u03b8\u03b5\u03b9\u03b1. \u0395\u03c0\u03af\u03c3\u03b7\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03c3\u03bf\u03c5 \u03b4\u03ce\u03c3\u03b5\u03b9 extra \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 \u03b5\u03ba\u03b5\u03af \u03c0\u03bf\u03c5 \u03c4\u03b7 \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c3\u03b1\u03b9, \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03b1\u03bd\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u03c5\u03c8\u03b7\u03bb\u03ae\u03c2 \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7\u03c2.<\/span><\/p>\n<p><span style=\"font-weight: 400\">\u0397 \u03ba\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03c9\u03c2 \u03c3\u03c5\u03bc\u03c0\u03bb\u03ae\u03c1\u03c9\u03bc\u03b1 \u03b4\u03b9\u03b1\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03b1\u03bd\u03b1\u03bb\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03ba\u03c5\u03c1\u03af\u03c9\u03c2 \u03c3\u03b5 \u03c0\u03b5\u03c1\u03b9\u03cc\u03b4\u03bf\u03c5\u03c2 \u03b1\u03cd\u03be\u03b7\u03c3\u03b7\u03c2 \u03cc\u03b3\u03ba\u03bf\u03c5. \u03a5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c3\u03b5 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03bc\u03bf\u03c1\u03c6\u03ae \u03c3\u03c4\u03bf \u03c3\u03ce\u03bc\u03b1, \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03bc\u03cd\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2. \u0397 \u03bb\u03ae\u03c8\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2 \u03b1\u03c5\u03be\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03b7 \u03c0\u03bf\u03c3\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7\u03c2 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03bc\u03cd\u03b5\u03c2, \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03b1\u03bd\u03b1\u03b5\u03c1\u03cc\u03b2\u03b9\u03b1 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b4\u03af\u03bd\u03bf\u03bd\u03c4\u03ac\u03c2 \u03c3\u03bf\u03c5 \u03c4\u03b7 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03ae\u03c8\u03b5\u03b9\u03c2 \u03ae\/\u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c3\u03b7\u03ba\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03ba\u03b9\u03bb\u03ac. \u039c\u03b5 \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03b1\u03c5\u03c4\u03cc \u03c3\u03c5\u03bc\u03b2\u03ac\u03bb\u03bb\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ac\u03bb\u03b9\u03c0\u03b7\u03c2 \u03bc\u03c5\u03ca\u03ba\u03ae\u03c2 \u03bc\u03ac\u03b6\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03cc\u03b3\u03ba\u03bf\u03c5.<\/span><\/p>\n<p><span style=\"font-weight: 400\">\u0397 100% \u039c\u03bf\u03bd\u03bf\u03cb\u03b4\u03c1\u03b9\u03ba\u03ae \u039a\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7 \u03c4\u03b7\u03c2 \u00abSuperior 14\u00bb \u03b4\u03b9\u03b1\u03c4\u03af\u03b8\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03bc\u03bf\u03c1\u03c6\u03ae \u03c3\u03ba\u03cc\u03bd\u03b7\u03c2, \u03c7\u03c9\u03c1\u03af\u03c2 \u03b3\u03b5\u03cd\u03c3\u03b7.<\/span><\/p>\n<p><b>\u0393\u03b9\u03b1\u03c4\u03af \u03bd\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03b5\u03b9\u03c2<\/b><\/p>\n<ul>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u03a0\u03c1\u03cc\u03c3\u03b8\u03b5\u03c3\u03b5 \u03c4\u03b7\u03bd \u00ab100% Monohydrate Creatine\u00bb \u03c3\u03c4\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1 \u03c4\u03c9\u03bd \u03c3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ac\u03c4\u03c9\u03bd \u03b4\u03b9\u03b1\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03bf\u03c5 \u03b1\u03bd \u03c3\u03c4\u03bf\u03c7\u03b5\u03cd\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03cc\u03b3\u03ba\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03bc\u03c5\u03ca\u03ba\u03ae \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u0398\u03b1 \u03b1\u03c5\u03be\u03ae\u03c3\u03b5\u03b9 \u03c4\u03b1 \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03b1 \u03ba\u03c1\u03b5\u03b1\u03c4\u03af\u03bd\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03bc\u03cd\u03b5\u03c2 \u03c3\u03bf\u03c5, \u03b4\u03af\u03bd\u03bf\u03bd\u03c4\u03ac\u03c2 \u03c3\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1 \u03c4\u03c9\u03bd \u03b1\u03c3\u03ba\u03ae\u03c3\u03b5\u03c9\u03bd<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u03a0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03ae\u03c8\u03b5\u03b9\u03c2, \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03ba\u03b9\u03bb\u03ac \u03c3\u03c4\u03b7 \u03bc\u03c0\u03ac\u03c1\u03b1 \u03ae \u03c3\u03c4\u03b9\u03c2 \u03b1\u03bd\u03c4\u03b9\u03c3\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u039c\u03b9\u03b1 \u03bc\u03b5\u03c1\u03af\u03b4\u03b1 \u03ad\u03c7\u03b5\u03b9 40 \u03b8\u03b5\u03c1\u03bc\u03af\u03b4\u03b5\u03c2<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">10 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ac\u03c1\u03b9\u03b1 \u03c5\u03b4\u03b1\u03c4\u03b1\u03bd\u03b8\u03c1\u03ac\u03ba\u03c9\u03bd<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u039c\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03ac \u03bb\u03b9\u03c0\u03b1\u03c1\u03ac<\/span><\/li>\n<li style=\"font-weight: 400\"><span style=\"font-weight: 400\">\u039c\u03b7\u03b4\u03b5\u03bd\u03b9\u03ba\u03ae \u03c0\u03c1\u03c9\u03c4\u03b5\u0390\u03bd\u03b7\u00a0<\/span><\/li>\n<\/ul>\n<p><b>\u03a0\u03c1\u03bf\u03c4\u03b5\u03b9\u03bd\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b4\u03bf\u03c3\u03bf\u03bb\u03bf\u03b3\u03af\u03b1<\/b><span style=\"font-weight: 400\">: \u0391\u03bd\u03ac\u03bc\u03b9\u03be\u03b5 1 \u03bc\u03b5\u03c1\u03af\u03b4\u03b1 (7 g) \u03bc\u03b5 \u03bd\u03b5\u03c1\u03cc \u03ae \u03ba\u03ac\u03c0\u03bf\u03b9\u03bf \u03c1\u03cc\u03c6\u03b7\u03bc\u03b1. \u0393\u03b9\u03b1 \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1, \u03ba\u03b1\u03c4\u03b1\u03bd\u03ac\u03bb\u03c9\u03c3\u03ad \u03c4\u03bf \u03c4\u03bf \u03c0\u03c1\u03b9\u03bd \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c0\u03cc\u03bd\u03b7\u03c3\u03b7.<\/span><\/p>\n<p>&nbsp;<\/p>\n<p><b>\u03a0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9\u03c2 - \u03a0\u03c1\u03bf